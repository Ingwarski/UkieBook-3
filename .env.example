# Server-only. Use a local or managed PostgreSQL connection; never expose it as NEXT_PUBLIC_*.
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>

# Identity runtime. Generate AUTH_SECRET with:
# node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64url'))"
APP_ENV=development
APP_ORIGIN=http://localhost:3000
AUTH_SECRET=replace-with-generated-secret
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

# Publishing runtime. Calibre is the selected EPUB/MOBI adapter; keep private
# artifacts outside public/ and mount PRIVATE_OBJECT_ROOT on durable private storage.
CALIBRE_EBOOK_CONVERT_PATH=/Applications/calibre.app/Contents/MacOS/ebook-convert
PRIVATE_OBJECT_ROOT=.data/private-objects
PUBLISHING_MAX_UPLOAD_BYTES=52428800
# Reversible launch defaults; product may change these without code changes.
PUBLISHING_PRICE_HINT_MIN_KOPIYKAS=9900
PUBLISHING_PRICE_HINT_MAX_KOPIYKAS=39900
GOOGLE_DOCS_EXPORT_ORIGIN=https://docs.google.com

# Commerce. Production Mono traffic is HTTPS-only. HTTP loopback is accepted
# solely with APP_ENV=test for the deterministic local provider simulator.
MONO_API_ORIGIN=https://api.monobank.ua
MONO_MERCHANT_TOKEN=
MONO_WEBHOOK_PUBLIC_KEY=
PAYMENT_WEBHOOK_MAX_BYTES=65536
PAYMENT_SESSION_VALIDITY_SECONDS=3600
PAYMENT_RECONCILIATION_INTERVAL_MS=30000

# Notifications. Production intentionally remains unavailable until a real
# transactional provider is configured; capture roots are test-only.
EMAIL_FROM=UkieBook <noreply@ukiebook.local>
EMAIL_CAPTURE_ROOT=
UNIT05_EMAIL_CAPTURE_ROOT=

# Non-secret runtime metadata.
APP_REVISION=development
WORKER_ID=local-worker
JOB_MAX_ATTEMPTS=5
JOB_LEASE_SECONDS=60
SCHEDULER_TICK_MS=60000

# The only public configuration in UNIT-00.
NEXT_PUBLIC_APP_ENV=development
