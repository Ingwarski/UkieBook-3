{
  "name": "ukiebook-3",
  "version": "0.1.0",
  "private": true,
  "description": "UkieBook modular monolith foundation",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:web && npm run build:runtime && npm run verify:runtime",
    "build:web": "next build && node scripts/prepare-standalone.mjs && node scripts/verify-client-boundary.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "verify:runtime": "node scripts/verify-runtime-identities.mjs",
    "start": "next start",
    "worker": "tsx workers/worker.ts",
    "scheduler": "tsx workers/scheduler.ts",
    "db:migrate": "tsx db/migrations/cli.ts up",
    "db:rollback": "tsx db/migrations/cli.ts down",
    "db:seed:unit02": "tsx scripts/seed-unit02-catalog.ts",
    "lint": "eslint . --max-warnings=0 && node scripts/verify-source-boundaries.mjs && node scripts/prove-client-boundary-negative.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest:e2e": "npm run build:web",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "pretest:visual": "npm run build:web",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:unit01:e2e": "playwright test --config playwright.unit01.e2e.config.ts",
    "test:unit01:visual": "playwright test --config playwright.unit01.visual.config.ts",
    "test:unit02:e2e": "playwright test --config playwright.unit02.e2e.config.ts",
    "test:unit02:visual": "playwright test --config playwright.unit02.visual.config.ts",
    "test:unit03:e2e": "playwright test --config playwright.unit03.e2e.config.ts",
    "test:unit03:visual": "playwright test --config playwright.unit03.visual.config.ts",
    "test:unit04:e2e": "playwright test --config playwright.unit04.e2e.config.ts",
    "test:unit04:visual": "playwright test --config playwright.unit04.visual.config.ts",
    "test:unit05:e2e": "node --import tsx scripts/unit05-embedded-postgres.mjs -- npx playwright test --config playwright.unit05.e2e.config.ts",
    "test:unit05:visual": "node --import tsx scripts/unit05-embedded-postgres.mjs -- npx playwright test --config playwright.unit05.visual.config.ts",
    "test:unit06:e2e": "node --import tsx scripts/unit06-embedded-postgres.mjs -- npx playwright test --config playwright.unit06.e2e.config.ts",
    "test:unit06:visual": "node --import tsx scripts/unit06-embedded-postgres.mjs -- npx playwright test --config playwright.unit06.visual.config.ts",
    "verify:repository": "node scripts/verify-repository-hygiene.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e && npm run test:visual",
    "verify:unit00": "node scripts/run-unit00-verification.mjs",
    "verify:unit01": "node scripts/run-unit01-verification.mjs",
    "verify:unit02": "npm run verify:unit02c1",
    "verify:unit02c1": "node scripts/run-unit02-verification.mjs",
    "verify:unit03:postgres": "tsx --conditions=react-server scripts/verify-unit03-postgres.ts",
    "verify:unit03": "node scripts/run-unit03-verification.mjs",
    "verify:unit04:postgres": "tsx --conditions=react-server scripts/verify-unit04-postgres.ts",
    "verify:unit04": "node scripts/run-unit04-verification.mjs",
    "verify:unit05:postgres": "node --import tsx scripts/unit05-embedded-postgres.mjs -- npx tsx --conditions=react-server scripts/verify-unit05-postgres.ts",
    "verify:unit05": "node --import tsx scripts/run-unit05-verification.mjs",
    "verify:unit06:postgres": "node --import tsx scripts/unit06-embedded-postgres.mjs -- npx tsx --conditions=react-server scripts/verify-unit06-postgres.ts",
    "verify:unit06": "node --import tsx scripts/run-unit06-verification.mjs"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "next": "16.2.11",
    "oauth4webapi": "3.8.6",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.11",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "jose": "6.1.2",
    "jsdom": "29.1.1",
    "tsx": "4.23.1",
    "typescript-eslint": "8.65.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.21",
    "sharp": "0.35.3"
  }
}
