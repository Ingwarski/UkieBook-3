{
  "name": "ukiebook-3",
  "version": "0.1.0",
  "private": true,
  "description": "UkieBook modular monolith foundation",
  "type": "module",
  "engines": {
    "node": ">=20.17.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:web && npm run build:runtime && npm run verify:runtime",
    "build:web": "next build && node scripts/prepare-standalone.mjs && node scripts/verify-client-boundary.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "verify:runtime": "node scripts/verify-runtime-identities.mjs",
    "start": "next start",
    "worker": "tsx workers/worker.ts",
    "scheduler": "tsx workers/scheduler.ts",
    "db:migrate": "tsx db/migrations/cli.ts up",
    "db:rollback": "tsx db/migrations/cli.ts down",
    "lint": "eslint . --max-warnings=0 && node scripts/verify-source-boundaries.mjs && node scripts/prove-client-boundary-negative.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest:e2e": "npm run build:web",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "pretest:visual": "npm run build:web",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "verify:repository": "node scripts/verify-repository-hygiene.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e && npm run test:visual",
    "verify:unit00": "node scripts/run-unit00-verification.mjs"
  },
  "dependencies": {
    "next": "16.2.11",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.21"
  }
}
